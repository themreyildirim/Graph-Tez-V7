{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "refusal_code",
        "items",
        "language"
      ],
      "properties": {
        "schema_version": {
          "const": "WP12-local-llm-candidate-v2"
        },
        "status": {
          "const": "candidate"
        },
        "refusal_code": {
          "const": null
        },
        "items": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "explanation_tr",
              "source_scope",
              "statement_kind",
              "evidence_ids"
            ],
            "properties": {
              "explanation_tr": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1200
              },
              "source_scope": {
                "enum": [
                  "animal_class_context",
                  "broad_antibacterial_including_doxycycline",
                  "broad_antibacterial_product_context",
                  "class_including_doxycycline",
                  "class_including_doxycycline_unknown",
                  "class_level",
                  "class_statement_with_doxycycline_exception",
                  "document_metadata",
                  "drug_direct",
                  "drug_direct_advice",
                  "drug_specific_historical_study_context",
                  "excipient_specific",
                  "mixed_drug_and_class_advice",
                  "mixed_drug_intro_and_class_list",
                  "mixed_warning_scopes",
                  "other_named_drug_tetracycline",
                  "overdose_context",
                  "product_identity",
                  "product_specific",
                  "related_drug_animal_invitro_context"
                ]
              },
              "statement_kind": {
                "enum": [
                  "adverse_context",
                  "adverse_section",
                  "currency_notice",
                  "formulation",
                  "identity",
                  "interaction",
                  "manufacturer",
                  "revision",
                  "scope_anchor",
                  "warning",
                  "warning_section"
                ]
              },
              "evidence_ids": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "minItems": 1
        },
        "language": {
          "const": "tr"
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "status",
        "refusal_code",
        "items",
        "language"
      ],
      "properties": {
        "schema_version": {
          "const": "WP12-local-llm-candidate-v2"
        },
        "status": {
          "const": "refused"
        },
        "refusal_code": {
          "enum": [
            "NO_SOURCE",
            "FORBIDDEN_TASK",
            "MISSING_CONTEXT",
            "IMAGE_TEXT_UNAVAILABLE",
            "CONTEXT_BUDGET",
            "UNCERTAIN_EVIDENCE"
          ]
        },
        "items": {
          "type": "array",
          "maxItems": 0
        },
        "language": {
          "const": "tr"
        }
      }
    }
  ]
}