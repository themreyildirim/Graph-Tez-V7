# Bu dosyayı `.env` olarak kopyalayın ve kendi değerlerinizi girin.
# `.env` .gitignore ile dışarıda bırakılmıştır — ASLA commit edilmez.

# WP12/WP13 OpenAI API adaptörü için (yalnız kullanıcı onaylı, bütçe sınırlı çalıştırmalarda)
OPENAI_API_KEY=

# Ham veri kökü (bkz. DATA_INVENTORY.md). Örnek:
# DATA_ROOT=C:\Users\<kullanici>\OneDrive\Masaustu\Tez Dosyalar\Dataset
DATA_ROOT=
